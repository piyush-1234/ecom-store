# ============================================================================
# ecomerce-store — environment template
# Copy to `.env` and fill in. NEVER commit `.env`.
#   cp .env.example .env
# ============================================================================

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# Docker:      postgresql://store:store@localhost:5432/store?schema=public
# Embedded:    postgresql://postgres:postgres@localhost:5433/store?schema=public
# Production:  Neon/Supabase pooled connection string
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://store:store@localhost:5432/store?schema=public
# Migrations bypass the pooler; set this to the DIRECT (non-pooled) URL in production.
DIRECT_URL=postgresql://store:store@localhost:5432/store?schema=public

# ---------------------------------------------------------------------------
# Auth
# AUTH_SECRET must be >= 32 chars. Generate: openssl rand -base64 32
# ---------------------------------------------------------------------------
AUTH_SECRET=replace-me-with-a-random-32-byte-secret-min-32-chars-long
SESSION_TTL_HOURS=720
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_PROVIDER=console

# ---------------------------------------------------------------------------
# Seller / GST (invoice legal identity)
# Placeholders until the business is registered. Drives invoice header.
# ---------------------------------------------------------------------------
GST_LEGAL_ENTITY_NAME=[LEGAL_ENTITY_NAME]
GST_GSTIN=[GSTIN]
GST_SELLER_ADDRESS=[SELLER_ADDRESS]
GST_SELLER_STATE=Maharashtra
GST_SELLER_STATE_CODE=27
GST_INVOICE_PREFIX=INV
GST_PRICES_INCLUDE_TAX=true

# ---------------------------------------------------------------------------
# Razorpay  (TEST keys only until approval gate #1 is cleared)
# Dashboard → Settings → API Keys → Generate Test Key
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_ENABLED=false

# ---------------------------------------------------------------------------
# Shipping — Shiprocket
# ---------------------------------------------------------------------------
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=Primary
SHIPROCKET_WEBHOOK_TOKEN=
SHIPROCKET_ENABLED=false

# ---------------------------------------------------------------------------
# Transactional email — Resend
# ---------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=ecomerce-store <orders@example.com>
EMAIL_ENABLED=false

# ---------------------------------------------------------------------------
# Image storage
# STORAGE_DRIVER: local | s3 | cloudinary
# "local" writes to public/uploads and MUST NOT be used in production.
# ---------------------------------------------------------------------------
STORAGE_DRIVER=local

S3_REGION=ap-south-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------------------------------------------------------------------------
# Analytics (placeholders — safe to leave blank in dev)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# ---------------------------------------------------------------------------
# Commerce rules
# ---------------------------------------------------------------------------
COD_MAX_AMOUNT_PAISE=150000
COD_FEE_PAISE=4900
PREPAID_DISCOUNT_PAISE=5000
FREE_SHIPPING_THRESHOLD_PAISE=149900
DEFAULT_SHIPPING_FEE_PAISE=4900
RETURN_WINDOW_DAYS=7
EXCHANGE_WINDOW_DAYS=15
