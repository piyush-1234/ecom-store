{
    "name": "ecomerce-store",
    "version": "0.1.0",
    "private": true,
    "description": "Single-vendor D2C ecommerce store for T-shirts and jeans — India-first, INR.",
    "engines": {
        "node": ">=20.0.0"
    },
    "scripts": {
        "dev": "next dev",
        "build": "prisma generate && next build",
        "start": "next start",
        "lint": "next lint",
        "typecheck": "tsc --noEmit",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run",
        "test:watch": "vitest",
        "db:generate": "prisma generate",
        "db:migrate": "prisma migrate dev",
        "db:deploy": "prisma migrate deploy",
        "db:seed": "tsx prisma/seed.ts",
        "db:studio": "prisma studio",
        "db:reset": "prisma migrate reset --force",
        "dev:db": "tsx scripts/dev-db.ts",
        "verify": "npm run typecheck && npm run lint && npm run test",
        "load:test": "node scripts/load-test.mjs",
        "test:e2e": "playwright test",
        "lighthouse:report": "node scripts/lighthouse-report.mjs",
        "cleanup:test": "node scripts/cleanup-test-data.mjs",
        "preflight": "node scripts/preflight.mjs"
    },
    "prisma": {
        "seed": "tsx prisma/seed.ts"
    },
    "dependencies": {
        "@prisma/client": "5.22.0",
        "bcryptjs": "^3.0.3",
        "class-variance-authority": "0.7.0",
        "clsx": "2.1.1",
        "date-fns": "3.6.0",
        "jose": "^6.2.12",
        "next": "14.2.35",
        "pdfkit": "^0.20.2",
        "react": "18.3.1",
        "react-dom": "18.3.1",
        "resend": "^6.34.1",
        "tailwind-merge": "2.5.4",
        "zod": "3.23.8"
    },
    "devDependencies": {
        "@playwright/test": "^1.64.1",
        "@types/bcryptjs": "^2.4.6",
        "@types/node": "22.9.0",
        "@types/pdfkit": "^0.17.6",
        "@types/react": "18.3.12",
        "@types/react-dom": "18.3.1",
        "autoprefixer": "10.4.20",
        "dotenv": "16.4.5",
        "embedded-postgres": "^18.4.0-beta.17",
        "eslint": "8.57.1",
        "eslint-config-next": "14.2.35",
        "lighthouse": "^13.5.0",
        "postcss": "8.4.47",
        "prettier": "3.3.3",
        "prisma": "5.22.0",
        "tailwindcss": "3.4.14",
        "tsx": "4.19.2",
        "typescript": "5.6.3",
        "vitest": "2.1.4"
    }
}
